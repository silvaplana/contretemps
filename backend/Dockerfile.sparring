# Conteneur « sparring-worker » : découpe des séances de Sparring en clips
# (spec/modules/video-combats.md §5 et §11, accord de Seb du 27/10/2026).
# Image à part parce que YOLO et PyTorch pèsent environ 1 Go : le backend
# n'en a pas besoin. Même code et même volume /app/data que le backend
# (base SQLite et vidéos), seule la commande change (docker-compose.yml).
FROM python:3.12-slim

WORKDIR /app

# Bibliothèques système d'OpenCV (lecture des images de la vidéo).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0t64 \
    && rm -rf /var/lib/apt/lists/*

# PyTorch en version processeur seul (pas de carte graphique sur le VPS),
# installé avant Ultralytics pour qu'il ne tire pas la version CUDA (plusieurs Go).
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir ultralytics opencv-python-headless faster-whisper

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir .

# Le modèle de postures (environ 6 Mo), téléchargé une fois dans l'image.
RUN mkdir -p /app/models && cd /app/models \
    && python -c "from ultralytics import YOLO; YOLO('yolo11n-pose.pt')"
ENV SPARRING_MODEL=/app/models/yolo11n-pose.pt
# Le modèle de parole Whisper « base » (environ 150 Mo) pour entendre les
# « Time ! » (session_clips/hearing.py, accord de Seb du 12/11/2026).
RUN python -c "from faster_whisper import download_model; download_model('base', output_dir='/app/models/whisper-base')"
# L'écoute précise, au choix dans les réglages de Fights (Seb, 14/11) : environ 480 Mo de plus.
RUN python -c "from faster_whisper import download_model; download_model('small', output_dir='/app/models/whisper-small')"
ENV SPARRING_SPEECH_MODEL=/app/models/whisper-base
ENV SPARRING_SPEECH_DIR=/app/models

RUN useradd --create-home appuser \
    && mkdir -p /app/data \
    && chown -R appuser:appuser /app/data
ENV DATABASE_URL=sqlite:////app/data/contretemps.db
ENV VIDEOS_DIR=/app/data/uploads/videos
# Réglages d'Ultralytics écrits dans le volume (le dossier personnel suffirait,
# mais il est perdu à chaque déploiement).
ENV YOLO_CONFIG_DIR=/app/data/ultralytics
USER appuser

# « nice » : la découpe passe après le backend et les autres workers.
CMD ["nice", "-n", "19", "python", "-u", "-m", "app.sparring_worker"]
