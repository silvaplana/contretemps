# DATABASE_URL : absent -> SQLite local (fichier contretemps.db, pratique
# en dev sans Postgres installé). En prod, une vraie URL Postgres (voir
# spec/SPEC.md section 1) :
#   DATABASE_URL=postgresql://user:motdepasse@host:5432/contretemps
#

# Notifications push (Web Push, voir notifications/ et spec/SPEC.md §8) —
# une paire de cles VAPID (Voluntary Application Server Identification),
# generee UNE FOIS par environnement (dev local / prod) et jamais commitee
# (voir .gitignore : .env). Sans elles, l'abonnement/l'envoi de
# notifications echoue (500) mais le reste de l'appli fonctionne
# normalement (feature isolee, voir notifications/notifications.py).
#
# Generation (32 octets bruts pour la privee, 65 pour la publique - point
# EC non compresse -, chacune encodee en base64url sans padding - le
# format attendu par PushManager.subscribe cote navigateur) :
#   python -c "
#   from py_vapid import Vapid02
#   from cryptography.hazmat.primitives.serialization import Encoding, PublicFormat
#   import base64
#   v = Vapid02(); v.generate_keys()
#   priv = v.private_key.private_numbers().private_value.to_bytes(32, 'big')
#   pub = v.public_key.public_bytes(Encoding.X962, PublicFormat.UncompressedPoint)
#   enc = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   print('VAPID_PRIVATE_KEY=' + enc(priv))
#   print('VAPID_PUBLIC_KEY=' + enc(pub))
#   "
# VAPID_PRIVATE_KEY=...
# VAPID_PUBLIC_KEY=...
# Contact requis par la norme VAPID (les serveurs de push - FCM, Mozilla
# Push Service... - peuvent s'en servir pour joindre l'operateur en cas de
# souci, ex. abus signale) - une adresse reelle, pas besoin d'etre une
# boite consultee activement.
# VAPID_SUBJECT=mailto:admin@silvaplana.cloud
