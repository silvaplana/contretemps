# Environnements virtuels
venv/
.venv/
env/

# Secrets locaux
.env

# Données réelles d'élèves (PII, jamais dans un repo public/déployé) et
# scripts de référence backend fournis hors-code — voir data/ et scripts/
data/
scripts/

# Bytecode / cache Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# BDD locale (SQLite, voir backend/src/db/database.py) — jamais commitée,
# chacun a la sienne en dev ; la prod utilise Postgres.
*.db
*.db-journal

# Fichiers vidéo (voir backend/src/videos/stockage.py) — jamais dans git
# (binaires, potentiellement volumineux) : "live" = uploads en cours,
# "reference" = jeu de démo utilisé par `python -m app.reset_demo`.
backend/uploads/
backend/videos_reference/

# Node / frontend
node_modules/
dist/
dist-android/
dist-ssr/
*.local

# Packaging
build/

# Éditeurs / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*:Zone.Identifier
