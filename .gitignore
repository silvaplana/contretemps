# Environnements virtuels
venv/
.venv/
env/

# Secrets locaux
.env

# Données réelles d'élèves (PII, jamais dans un repo public/déployé) et
# scripts de référence backend fournis hors-code — voir data/ et scripts/
data/
scripts/

# Bytecode / cache Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# BDD locale (SQLite, voir backend/src/db/database.py) — jamais commitée,
# chacun a la sienne en dev ; la prod utilise Postgres.
*.db
*.db-journal

# Fichiers vidéo "live" (voir backend/src/videos/stockage.py) — jamais
# dans git : uploads réels, potentiellement volumineux/futurs, propres à
# chaque déploiement. `backend/videos_reference/` N'EST PAS ignoré : voir
# ce dossier — c'est un petit jeu de démo curaté et committé (comme
# seed_data/), pas des uploads arbitraires.
backend/uploads/

# Node / frontend
node_modules/
dist/
dist-android/
dist-ssr/
*.local

# Packaging
build/

# Éditeurs / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*:Zone.Identifier
